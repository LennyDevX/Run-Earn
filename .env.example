# Public Polygon configuration. Keep local values in .env.local or your deployment provider.
# Production defaults use Polygon mainnet. Use Polygon Amoy explicitly for testing.
NEXT_PUBLIC_POLYGON_NETWORK=polygon
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon.drpc.org
NEXT_PUBLIC_POLYGON_EXPLORER=https://polygonscan.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional application contract addresses. Leave empty until contracts are deployed.
NEXT_PUBLIC_REWARD_TOKEN_ADDRESS=
NEXT_PUBLIC_STAKING_VAULT_ADDRESS=
NEXT_PUBLIC_SNEAKER_MINT_ADDRESS=
NEXT_PUBLIC_SNEAKER_APPRAISER_ADDRESS=
NEXT_PUBLIC_SNEAKER_MARKETPLACE_ADDRESS=
NEXT_PUBLIC_SNEAKER_GAME_ADDRESS=
NEXT_PUBLIC_VE_SNEAKER_STORE_ADDRESS=
# Upgrade economy (v1.0)
NEXT_PUBLIC_SNEAKER_MODS_ADDRESS=
NEXT_PUBLIC_MOD_STORE_ADDRESS=
# Player progression (v1.0): XP, levels, public username/avatar identity
NEXT_PUBLIC_PLAYER_PROGRESS_ADDRESS=
# Benefits vault: perk discounts and exclusive access (v1.1)
NEXT_PUBLIC_SNEAKER_VAULT_ADDRESS=
SNEAKER_VAULT_ADDRESS=
# Fee splitter: pro-rata distribution of marketplace/rental fees
NEXT_PUBLIC_FEE_SPLITTER_ADDRESS=
FEE_SPLITTER_ADDRESS=
# Fee recipients must accept native POL (use wallets, not contracts without receive()).
# Unset values default to DEPLOY_ADMIN_ADDRESS; recommended weights are 40/30/20/10.
FEE_SPLITTER_TREASURY_ADDRESS=
FEE_SPLITTER_STAKING_WALLET_ADDRESS=
FEE_SPLITTER_REDEMPTION_WALLET_ADDRESS=
FEE_SPLITTER_TEAM_ADDRESS=
# Initial SneakerVault perk 0 (Mythic discount) and perk 1 (exclusive access) seed values.
SNEAKER_VAULT_DISCOUNT_BPS=1000
SNEAKER_VAULT_DISCOUNT_MIN_TIER=3
SNEAKER_VAULT_DISCOUNT_REQUIRED_LEVEL=0
SNEAKER_VAULT_DISCOUNT_MIN_POL_WEI=0
SNEAKER_VAULT_DISCOUNT_MIN_CONDITION_BPS=0
SNEAKER_VAULT_DISCOUNT_MIN_MOD_COUNT=0
SNEAKER_VAULT_ACCESS_MIN_TIER=3
SNEAKER_VAULT_ACCESS_REQUIRED_LEVEL=5
SNEAKER_VAULT_ACCESS_MIN_POL_WEI=0
SNEAKER_VAULT_ACCESS_MIN_CONDITION_BPS=0
SNEAKER_VAULT_ACCESS_MIN_MOD_COUNT=0

# The Graph query configuration. Keep the API key server-only; the deploy key is not a query key.
THE_GRAPH_QUERY_URL=
THE_GRAPH_QUERY_API_KEY=
THE_GRAPH_SUBGRAPH_SLUG=nuxgraph
THE_GRAPH_SUBGRAPH_VERSION=0.1.0

# Uniswap Trading API (server-only) — powers the live POL/USD feed at /api/pol-price.
# Get a key at https://developers.uniswap.org/. The browser never sees this key.
UNISWAP_API_KEY=
UNISWAP_TRADING_API_URL=https://trade-api.gateway.uniswap.org/v1
# Read-only quote probe: any valid Polygon address. Defaults to the store treasury,
# then the deploy admin, then the zero address.
UNISWAP_QUOTE_SWAPPER=
POL_PRICE_CACHE_SECONDS=300
# scripts/mint-veSneakers.ts fetches the live POL/USD rate to convert USD targets to
# POL. Set to false to pin the conversion to POL_USD_PRICE instead.
VE_USE_LIVE_POL_PRICE=true

# ─── AI mint studio (server-only) ────────────────────────────────────────────
# Powers /api/generate-sneaker: a vision pass grades the source sneaker and a
# render pass produces the pixel-art collectible. The key never reaches the
# browser. Get one at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
# Override the model names if Google rotates them; no code change needed.
GEMINI_ANALYSIS_MODEL=gemini-3-flash-preview
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Global daily ceiling on paid generations. A per-IP rate limit cannot stop a
# botnet spreading requests across addresses; this cap does, because it does not
# care who is asking. Keep it generous enough for real beta traffic.
GENERATION_DAILY_BUDGET=300

# ─── Rate limiting backend (optional) ────────────────────────────────────────
# Without these the limiter falls back to in-process memory, which only counts
# per serverless instance — fine locally, useless on Vercel. Add Upstash for
# Redis from the Vercel Marketplace and both variables are injected for you.
# `Redis.fromEnv()` also accepts the Vercel KV integration names
# (KV_REST_API_URL / KV_REST_API_TOKEN), so either integration works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Hardhat deployment and verification (server/terminal only; never NEXT_PUBLIC_)
POLYGON_RPC_URL=
POLYGON_AMOY_RPC_URL=
DEPLOYER_PRIVATE_KEY=
POLYGONSCAN_API_KEY=
SKIP_VERIFY=false
VERIFY_DELAY_MS=15000
MIN_DEPLOYER_BALANCE_WEI=0

# Deploy parameters
DEPLOY_TARGET=all
DEPLOY_ADMIN_ADDRESS=
STAKING_ADMIN_ADDRESS=
APPRAISER_ADMIN_ADDRESS=
MARKETPLACE_ADMIN_ADDRESS=
MARKETPLACE_FEE_COLLECTOR_ADDRESS=
GAME_ADMIN_ADDRESS=
VE_STORE_ADMIN_ADDRESS=
VE_STORE_TREASURY_ADDRESS=
RUNE_MINTER_ADDRESS=
RUNE_TOKEN_ADDRESS=
SNEAKER_MINT_ADDRESS=
SNEAKER_NFT_NAME=RUN&EARN Sneakers
SNEAKER_NFT_SYMBOL=RSNEAK
REWARD_TOKENS_PER_NFT_YEAR=1000000000000000000000
STAKING_BASE_APY_BPS=280
STAKING_PER_NFT_BONUS_BPS=0
STAKING_MAX_APY_BPS=800
STAKING_MIN_LOCK_SECONDS=2592000

# SneakerAppraiser valuation parameters (in wei)
APPRAISER_BASE_VALUE=500000000000000000
APPRAISER_TIER0_VALUE=0
APPRAISER_TIER1_VALUE=1000000000000000000
APPRAISER_TIER2_VALUE=3000000000000000000
APPRAISER_TIER3_VALUE=8000000000000000000
APPRAISER_RARITY_WEIGHT=10000000000000000
APPRAISER_MULTIPLIER_BPS=10000
# AI collectible valuation track (separate from veSneakers). Tuned so the
# marketplace price — appraisal x the 1.2x premium — lands in 250-8,000 POL.
COLLECTIBLE_APPRAISER_BASE_VALUE=210000000000000000000
COLLECTIBLE_APPRAISER_TIER0_VALUE=0
COLLECTIBLE_APPRAISER_TIER1_VALUE=600000000000000000000
COLLECTIBLE_APPRAISER_TIER2_VALUE=2200000000000000000000
COLLECTIBLE_APPRAISER_TIER3_VALUE=5350000000000000000000
COLLECTIBLE_APPRAISER_RARITY_WEIGHT=10000000000000000000
COLLECTIBLE_APPRAISER_MULTIPLIER_BPS=10000

# SneakerMarketplace parameters
MARKETPLACE_FEE_BPS=250
MARKETPLACE_APPRAISER_PREMIUM_BPS=12000

# SneakerGame (veRUNE) parameters (in wei unless noted)
GAME_TIER0_POINTS_PER_DAY=100000000000000000000
GAME_TIER1_POINTS_PER_DAY=200000000000000000000
GAME_TIER2_POINTS_PER_DAY=400000000000000000000
GAME_TIER3_POINTS_PER_DAY=800000000000000000000
GAME_STREAK_BONUS_STEP_BPS=100
GAME_MAX_DURABILITY=10
GAME_WEAR_PER_ACTIVATION=1
GAME_REPAIR_COST_POINTS=50000000000000000000
GAME_REDEMPTION_RATE=100000000000000000000

# veSneaker primary sale (VeSneakerStore). Prices are defined in USD and converted to
# POL with POL_USD_PRICE. The defaults match the POL ladder below at POL = $0.09764.
# Set VE_PRICE_*_POL to pin an individual price in POL directly.
#
#   Sol   (Rare)    1500 POL
#   Luna  (Epic)    2100 POL
#   Astra (Mythic)  3000 POL
POL_USD_PRICE=0.09764
VE_MAX_SUPPLY=1000
VE_PRICE_COMMON_USD=98
VE_PRICE_RARE_USD=146
VE_PRICE_EPIC_USD=205
VE_PRICE_MYTHIC_USD=293
VE_PRICE_COMMON_POL=
VE_PRICE_RARE_POL=
VE_PRICE_EPIC_POL=
VE_PRICE_MYTHIC_POL=
VE_SNEAKER_STORE_ADDRESS=
VE_SNEAKER_ASSET_BASE_URL=
VE_UPDATE_DESIGN_URIS=false
VE_MINT_MODE=configure
VE_MINT_QUANTITY=0
VE_MINT_RECIPIENT=

# Upgrade economy (v1.0) deployment
MODS_ADMIN_ADDRESS=
MODS_NFT_NAME=RUN&EARN Mods
MODS_NFT_SYMBOL=RMOD
WORKSHOP_ADMIN_ADDRESS=
# veSneaker care: a 365-day wear season with a 50% floor. There is no forge —
# mods are the only upgrade path and the sneaker is the only thing that wears.
WORKSHOP_CONDITION_FLOOR_BPS=5000
WORKSHOP_SEASON_SECONDS=31536000
SWAP_ADMIN_ADDRESS=
MOD_STORE_ADMIN_ADDRESS=
MOD_STORE_TREASURY_ADDRESS=
SNEAKER_MODS_ADDRESS=
SNEAKER_GAME_ADDRESS=
SNEAKER_WORKSHOP_ADDRESS=
# Daily tab arena: the signer that authorises completed off-chain sessions.
SNEAKER_TAB_ARENA_ADDRESS=
ARENA_SIGNER_ADDRESS=
# Server-only key for /api/tab-session. It signs completed tap sessions; the
# contract recomputes power and clamps the score, so this key cannot mint an
# unbounded boost. Never expose it to the browser.
ARENA_SIGNER_PRIVATE_KEY=
SNEAKER_SWAP_ADDRESS=
MARKETPLACE_ADDRESS=
SNEAKER_APPRAISER_ADDRESS=
PROGRESS_ADMIN_ADDRESS=
VAULT_ADMIN_ADDRESS=
FEE_SPLITTER_ADMIN_ADDRESS=
PROGRESS_LEVEL_THRESHOLDS=

# Staking funding
STAKING_VAULT_ADDRESS=
FUNDING_WALLET_ADDRESS=
FUNDING_PRIVATE_KEY=
FUND_ASSET=POL
FUND_AMOUNT=
