# Public Polygon configuration. Keep local values in .env.local or your deployment provider.
# Production defaults use Polygon mainnet. Use Polygon Amoy explicitly for testing.
NEXT_PUBLIC_POLYGON_NETWORK=polygon
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon.drpc.org
NEXT_PUBLIC_POLYGON_EXPLORER=https://polygonscan.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional application contract addresses. Leave empty until contracts are deployed.
NEXT_PUBLIC_REWARD_TOKEN_ADDRESS=
NEXT_PUBLIC_STAKING_VAULT_ADDRESS=
NEXT_PUBLIC_SNEAKER_MINT_ADDRESS=

# The Graph query configuration. Keep the API key server-only; the deploy key is not a query key.
THE_GRAPH_QUERY_URL=
THE_GRAPH_QUERY_API_KEY=
THE_GRAPH_SUBGRAPH_SLUG=nuxgraph
THE_GRAPH_SUBGRAPH_VERSION=0.1.0

# Hardhat deployment and verification (server/terminal only; never NEXT_PUBLIC_)
POLYGON_RPC_URL=
POLYGON_AMOY_RPC_URL=
DEPLOYER_PRIVATE_KEY=
POLYGONSCAN_API_KEY=
SKIP_VERIFY=false
VERIFY_DELAY_MS=15000
MIN_DEPLOYER_BALANCE_WEI=0

# Deploy parameters
DEPLOY_TARGET=all
DEPLOY_ADMIN_ADDRESS=
STAKING_ADMIN_ADDRESS=
RUNE_MINTER_ADDRESS=
RUNE_TOKEN_ADDRESS=
SNEAKER_MINT_ADDRESS=
SNEAKER_NFT_NAME=RUN&EARN Sneakers
SNEAKER_NFT_SYMBOL=RSNEAK
REWARD_TOKENS_PER_NFT_YEAR=1000000000000000000000
STAKING_BASE_APY_BPS=400
STAKING_PER_NFT_BONUS_BPS=50
STAKING_MAX_APY_BPS=800
STAKING_MIN_LOCK_SECONDS=604800

# Staking funding
STAKING_VAULT_ADDRESS=
FUNDING_WALLET_ADDRESS=
FUNDING_PRIVATE_KEY=
FUND_ASSET=POL
FUND_AMOUNT=
